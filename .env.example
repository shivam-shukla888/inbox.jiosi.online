# ==============================================================================
# JIOSI Inbox — Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# Database Configuration (PostgreSQL)
# Option A: Local Docker Compose (Default for local offline development)
# Use 'localhost' and 5433 when running backend directly on host machine
# Docker Compose overrides these to 'postgres' and 5432 automatically
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=jiosi_inbox
POSTGRES_USER=jiosi_user
POSTGRES_PASSWORD=jiosi_secure_password_example

# Option B: Neon PostgreSQL Serverless Integration
# Set DATABASE_URL in .env.local to point to your Neon project endpoint.
# HikariCP connects to the pooled endpoint (-pooler) with prepareThreshold=0.
# Flyway automatically routes DDL migrations to the direct endpoint (unpooled) for session lock stability.
# Example format:
# DATABASE_URL=jdbc:postgresql://ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_USERNAME=neondb_owner
# DATABASE_PASSWORD=your_neon_password_here
# Optional Direct Flyway Migration URL override (auto-derived if not provided):
# FLYWAY_URL=jdbc:postgresql://ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Host mapped PostgreSQL port (for local tools / psql / host running)
HOST_POSTGRES_PORT=5433

# Spring Boot Backend Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
HIKARI_MAX_POOL_SIZE=25
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://inbox.jiosi.online

# Authentication & Google OIDC Configuration
GOOGLE_CLIENT_ID=540933255986-asmkro9uiiafqm9lohf73f4uf4insc1u.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
JWT_SECRET=your-minimum-32-character-hmac-sha-secret-here
FRONTEND_URL=http://localhost:5173

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080
FRONTEND_PORT=5173
